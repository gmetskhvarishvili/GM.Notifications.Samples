{
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=GMNotificationsSample;Username=postgres;Password=123456"
  },
  "Messaging": {
    "ServiceName": "GM.Notifications.Sample.Consumer.Worker",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "guest",
      "Password": "guest"
    },
    "Retry": {
      "MaxAttempts": 5,
      "InitialDelayMilliseconds": 250
    },
    "CircuitBreaker": {
      "Enabled": true,
      "TrackingPeriodSeconds": 60,
      "PauseTimeSeconds": 30,
      "FailurePercentageThreshold": 25,
      "MinimumThreshold": 10
    }
  },
  "ConsumerTopology": {
    "DeadLetterQueue": "gm.notifications.dead-letter",
    "Bindings": [
      {
        "Exchange": "gm.events",
        "Kind": "Topic",
        "Queue": "gm.notifications.user-registered",
        "RoutingKey": "user.registered"
      },
      {
        "Exchange": "gm.events",
        "Kind": "Topic",
        "Queue": "gm.notifications.user-confirmed",
        "RoutingKey": "user.confirmed"
      },
      {
        "Exchange": "gm.events",
        "Kind": "Topic",
        "Queue": "gm.notifications.otp-generated",
        "RoutingKey": "otp.generated"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
