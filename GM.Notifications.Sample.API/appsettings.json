{
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=GMNotificationsSample;Username=postgres;Password=123456"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SwaggerDocOptions": {
    "Title": "GM Notifications API",
    "Description": "GM Sample Notifications API",
    "Contact": {
      "Name": "Giorgi Metskhvarishvili",
      "Email": "gmetskhvarishvili95@gmail.com",
      "Url": "https://metskhvarishvili.com"
    },
    "License": {
      "Name": "License",
      "Url": "https://opensource.org/licenses/MIT"
    },
    "Headers": [
      "Accept-Language",
      "Authorization"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Graylog",
      "Serilog.Enrichers.HttpContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Migrations": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Model.Validation": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithHttpContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} {Level:u3} {Message:lj}{NewLine:1}{Exception:1}"
        }
      }
    ]
  }
}
