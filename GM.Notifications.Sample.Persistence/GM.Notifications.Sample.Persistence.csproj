<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GM.EntityFramework.Persistence" Version="1.2.2" />
        <PackageReference Include="GM.Notifications" Version="1.0.1" />
        <PackageReference Include="GM.Notifications.Persistence" Version="1.0.1" />
        <!--
          Pinned explicitly (not just transitively via GM.EntityFramework.Domain's 10.0.10 floor):
          the Design/Tools packages below are PrivateAssets="all", so their own 10.0.11 requirement
          does not flow to downstream ProjectReference consumers (the Worker projects), which would
          otherwise resolve EFCore to 10.0.10 and conflict with this assembly's actual 10.0.11 build.
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GM.Notifications.Sample.Application\GM.Notifications.Sample.Application.csproj" />
        <ProjectReference Include="..\GM.Notifications.Sample.Common\GM.Notifications.Sample.Common.csproj" />
        <ProjectReference Include="..\GM.Notifications.Sample.Domain\GM.Notifications.Sample.Domain.csproj" />
    </ItemGroup>

</Project>
